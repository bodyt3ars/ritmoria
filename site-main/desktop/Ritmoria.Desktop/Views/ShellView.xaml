<UserControl
    x:Class="Ritmoria.Desktop.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="34,26,34,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="Главная" Foreground="White" FontSize="38" FontWeight="Bold" />
                <TextBlock Text="{Binding CurrentUserName}" Foreground="{StaticResource RitmoriaMutedTextBrush}" FontSize="14" />
            </StackPanel>

            <TextBox Grid.Column="1" PlaceholderText="Поиск треков, артистов..." Height="44" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14">
                <Border Padding="22" CornerRadius="18" BorderBrush="#2C2531" BorderThickness="1" Background="{StaticResource RitmoriaPanelBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="HeroTitle" Text="Добро пожаловать в Ритморию Desktop" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeroSubtitle" Text="Это нативный Windows-клиент. Сайт остаётся отдельно и не ломается." Foreground="{StaticResource RitmoriaMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsRepeater x:Name="TrackRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="16" CornerRadius="16" BorderBrush="#2C2531" BorderThickness="1" Background="#16131A">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="56" Height="56" CornerRadius="12" Background="#2A202E" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource RitmoriaMutedTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="▶" Width="44" Height="44" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="14">
                <Border Padding="18" CornerRadius="18" BorderBrush="#2C2531" BorderThickness="1" Background="{StaticResource RitmoriaPanelBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Статус" Foreground="{StaticResource RitmoriaMutedTextBrush}" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="MVP shell готов" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Padding="18" CornerRadius="18" BorderBrush="#3C2A3A" BorderThickness="1" Background="#1D1420">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Следующий слой" Foreground="{StaticResource RitmoriaMutedTextBrush}" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="Подключить живые API страниц, затем нативный плеер." Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

