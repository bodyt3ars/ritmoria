<Window
    x:Class="Ritmoria.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ritmoria.Desktop.Views"
    Title="Ритмория">

    <Grid Background="{StaticResource RitmoriaBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="0"
            PaneDisplayMode="LeftCompact"
            IsSettingsVisible="False"
            Background="{StaticResource RitmoriaBgBrush}"
            SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Рейтинг" Tag="rating" Icon="Favorite" />
                <NavigationViewItem Content="Плейлисты" Tag="playlists" Icon="Library" />
                <NavigationViewItem Content="Профиль" Tag="profile" Icon="Contact" />
                <NavigationViewItem Content="Beat Rush" Tag="beatRush" Icon="Play" />
            </NavigationView.MenuItems>

            <Grid>
                <views:LoginView x:Name="LoginView" />
                <views:ShellView x:Name="ShellView" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <Border
            Grid.Row="1"
            Margin="14,0,14,14"
            Padding="18,12"
            CornerRadius="18"
            BorderBrush="#2C2531"
            BorderThickness="1"
            Background="#EE151219">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="54" Height="54" CornerRadius="14" Background="#2A202E">
                    <TextBlock Text="R" Foreground="{StaticResource RitmoriaAccentBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlayerTitle}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlayerArtist}" Foreground="{StaticResource RitmoriaMutedTextBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="⏮" Width="44" Height="44" />
                    <Button Content="▶" Width="52" Height="52" Background="{StaticResource RitmoriaAccentBrush}" />
                    <Button Content="⏭" Width="44" Height="44" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

