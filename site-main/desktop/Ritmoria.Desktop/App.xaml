<Application
    x:Class="Ritmoria.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="RitmoriaBgColor">#09090D</Color>
            <Color x:Key="RitmoriaPanelColor">#17131B</Color>
            <Color x:Key="RitmoriaAccentColor">#D884B6</Color>
            <Color x:Key="RitmoriaAccentBlueColor">#78A8FF</Color>
            <SolidColorBrush x:Key="RitmoriaBgBrush" Color="{StaticResource RitmoriaBgColor}" />
            <SolidColorBrush x:Key="RitmoriaPanelBrush" Color="{StaticResource RitmoriaPanelColor}" />
            <SolidColorBrush x:Key="RitmoriaAccentBrush" Color="{StaticResource RitmoriaAccentColor}" />
            <SolidColorBrush x:Key="RitmoriaAccentBlueBrush" Color="{StaticResource RitmoriaAccentBlueColor}" />
            <SolidColorBrush x:Key="RitmoriaTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="RitmoriaMutedTextBrush" Color="#A8A2AD" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

