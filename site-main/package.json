{
  "name": "music-platform",
  "version": "1.0.3",
  "description": "Desktop app for Ritmoria music platform",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "electron:build:web": "electron-builder --win nsis",
    "electron:pack": "electron-builder --win --dir",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Ritmoria",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ritmoria.desktop",
    "productName": "Ritmoria",
    "executableName": "Ritmoria",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist-desktop-web"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "!public/download/**/*",
      "!public/uploads/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/icon.ico"
    },
    "nsis": {
      "installerIcon": "public/images/icon.ico",
      "uninstallerIcon": "public/images/icon.ico",
      "artifactName": "RitmoriaSetup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ритмория"
    },
    "publish": {
      "provider": "generic",
      "url": "https://ritmoria.com/download/"
    }
  }
}
